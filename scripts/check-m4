#!/usr/bin/env bash
set -euo pipefail

printf 'Checking milestone m4: full quiz flow\n'

required_files=(
  "docs/plans/2026-04-27-quizzer-v1-milestone-4-full-quiz-flow.md"
  "docs/status.md"
)

missing=0
for path in "${required_files[@]}"; do
  if [[ ! -e "$path" ]]; then
    printf 'Missing milestone prerequisite: %s\n' "$path"
    missing=1
  fi
done

if [[ "$missing" -ne 0 ]]; then
  printf 'M4 check failed. Restore the missing milestone prerequisites and retry.\n'
  exit 1
fi

printf 'Progression and final-results app checks are deferred until implementation exists.\n'
printf 'M4 check OK\n'
