#!/usr/bin/env bash
set -euo pipefail

printf 'Checking milestone m1: single-host authoring\n'

required_files=(
  "docs/status.md"
  "docs/plans/2026-04-27-quizzer-v1-milestone-1-single-host-authoring.md"
  "commands/plan"
  "commands/status"
  "commands/verify"
  "package.json"
  "app/host/page.tsx"
  "app/host/[quizId]/page.tsx"
  "app/auth/callback/route.ts"
  "lib/quiz-validation.ts"
  "tests/quiz-validation.test.ts"
  "supabase/migrations/20260427120000_m1_single_host_authoring.sql"
  "supabase/migrations/20260427130000_m1_authoring_helpers.sql"
)

missing=0
for path in "${required_files[@]}"; do
  if [[ ! -e "$path" ]]; then
    printf 'Missing milestone prerequisite: %s\n' "$path"
    missing=1
  fi
done

if [[ "$missing" -ne 0 ]]; then
  printf 'M1 check failed. Restore the missing milestone prerequisites and retry.\n'
  exit 1
fi

printf 'Running M1 app checks\n'
npm run typecheck
npm run lint
npm test
npm run build

printf 'M1 check OK\n'
