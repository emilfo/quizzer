#!/usr/bin/env bash
set -euo pipefail

printf 'Checking milestone m2: joinable live session\n'

required_files=(
  "docs/status.md"
  "docs/plans/2026-04-27-quizzer-v1-milestone-2-joinable-live-session.md"
  "commands/verify"
  "package.json"
  "scripts/check-m2"
  "app/host/session/[sessionId]/page.tsx"
  "app/play/actions.ts"
  "app/play/[joinCode]/page.tsx"
  "app/projector/[joinCode]/page.tsx"
  "components/live-session-panel.tsx"
  "tests/live-session.test.ts"
  "lib/live-session.ts"
  "supabase/migrations/20260427150000_m2_live_session_schema.sql"
  "supabase/migrations/20260427151000_m2_live_session_helpers.sql"
)

missing=0
for path in "${required_files[@]}"; do
  if [[ ! -e "$path" ]]; then
    printf 'Missing milestone prerequisite: %s\n' "$path"
    missing=1
  fi
done

if [[ "$missing" -ne 0 ]]; then
  printf 'M2 check failed. Restore the missing milestone files and retry.\n'
  exit 1
fi

printf 'Running M2 app checks\n'
npm run typecheck
npm run lint
npm test
npm run build

printf 'M2 check OK\n'
