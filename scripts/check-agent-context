#!/usr/bin/env bash
set -euo pipefail

printf 'Checking agent context integrity\n'

required_dirs=(
  "commands"
  "config"
  "docs"
  "hooks"
  "scripts"
  "src/harness"
)

required_files=(
  "AGENTS.md"
  "README.md"
  "docs/agent-map.md"
  "docs/architecture.md"
  "docs/constraints.md"
  "docs/quality.md"
  "docs/quickstart.md"
  "docs/status.md"
  "docs/plans/README.md"
  "docs/plans/template.md"
  "commands/plan"
  "commands/status"
  "commands/verify"
  "scripts/check-m1"
  "scripts/check-m2"
  "scripts/check-m3"
  "scripts/check-m4"
  "scripts/check-m5"
)

missing=0
for path in "${required_dirs[@]}"; do
  if [[ ! -d "$path" ]]; then
    printf 'Missing required directory: %s\n' "$path"
    missing=1
  fi
done

for path in "${required_files[@]}"; do
  if [[ ! -f "$path" ]]; then
    printf 'Missing required file: %s\n' "$path"
    missing=1
  fi
done

if [[ "$missing" -ne 0 ]]; then
  printf 'Context check failed. Restore the missing paths and retry.\n'
  exit 1
fi

printf 'Context check OK\n'
