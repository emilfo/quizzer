#!/usr/bin/env bash
set -euo pipefail

printf 'Checking milestone m3: one question end-to-end\n'

required_files=(
  "docs/plans/2026-04-27-quizzer-v1-milestone-3-one-question-end-to-end.md"
  "docs/status.md"
  "lib/gameplay.ts"
)

missing=0
for path in "${required_files[@]}"; do
  if [[ ! -e "$path" ]]; then
    printf 'Missing milestone prerequisite: %s\n' "$path"
    missing=1
  fi
done

if [[ "$missing" -ne 0 ]]; then
  printf 'M3 check failed. Restore the missing milestone prerequisites and retry.\n'
  exit 1
fi

run_step() {
  local label="$1"
  shift

  printf '%s\n' "$label"
  if ! "$@"; then
    printf 'M3 check failed during: %s\n' "$label"
    exit 1
  fi
}

run_step 'Running typecheck...' npm run typecheck
run_step 'Running lint...' npm run lint
run_step 'Running tests...' npm test
run_step 'Running build...' npm run build

printf 'M3 check OK\n'
