#!/usr/bin/env bash
set -euo pipefail

printf 'Checking milestone m5: hardening\n'

required_files=(
  "docs/plans/2026-04-27-quizzer-v1-milestone-5-hardening.md"
  "docs/status.md"
  "docs/constraints.md"
  "docs/quality.md"
)

missing=0
for path in "${required_files[@]}"; do
  if [[ ! -e "$path" ]]; then
    printf 'Missing milestone prerequisite: %s\n' "$path"
    missing=1
  fi
done

if [[ "$missing" -ne 0 ]]; then
  printf 'M5 check failed. Restore the missing milestone prerequisites and retry.\n'
  exit 1
fi

printf 'Reconnect, security, and regression app checks are deferred until implementation exists.\n'
printf 'M5 check OK\n'
